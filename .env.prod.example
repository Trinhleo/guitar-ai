# Production — copy to .env.prod and fill in values.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod

POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-secret
GO_ENV=production

# Optional: Fly.io API URL for client-side fallback when VPS is down.
# Flutter web build picks this up via docker-compose build args (see docker-compose.prod.yml).
FLY_API_URL=https://your-app.fly.dev

# Optional: shared external Postgres (Neon) — use same URL on Fly + VPS for synced data.
# EXTERNAL_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
